 r←by;t
 t←⎕NS ⍬
 t.data←#.data
 t.monadic←{
     r←+⌿data.by ⍺⊢⍵
     s←+⌿data.by(⍵[⍺])⊢⍵[⍵.labels~⍺]
     ##.assert r≡⍥{⍵.(labels values)}s:
     ⍵
 }
 t.dyadic←{
     r←+⌿data.by ⍺⊢⍵
     s←'abc'+⌿data.by ⍺⊢⍵
     ##.assert r≡⍥{⍵.values}s:
     ##.assert s.(index columns).label≡'ab'(,'c'):
     s←(⊂'other')+⌿data.by ⍺⊢⍵
     ##.assert r≡⍥{⍵.values}s:
     ##.assert s.(index columns).label≡⍺(,⊂'other'):
     s←(⊂'other')+⌿data.by(⍵[⍺])⊢⍵[⍵.labels~⍺]
     ##.assert r≡⍥{⍵.values}s:
     ##.assert s.(index columns).label≡⍺(,⊂'other'):
     ⍵
 }
 t.stack←{
     u←⍺⍺ data.by ⍺⊢⍵
     l←u.labels~⍵.labels
     f←(⊂⍺)⍋data.sort l(⍺⍺ data.by ⍺)u
     ##.assert f≡⍥{⍵.(labels values)}(⊂'one')data.frame ⍵:
     g←(⊂⍺)data.(⍋sort∘frame)u[l](⍺⍺ data.by ⍺)u[u.series.label~l]
     ##.assert f≡⍥{⍵.(labels values)}g:
     v←⍺⍺ data.by(⍵[⊂⍺])⊢⍵[⍵.labels~⊂⍺]
     ##.assert u≡⍥{⍵.(labels values)}v:
     ⍵
 }
 r←0
 r←t.('one' 'two'monadic(⊂'one')monadic f←'one' 'two' 'three'data.frame'aaabbb'(0 1 2 0 1 2)(⍳6))
 r←t.('one'('three'stack)'one' 'two'dyadic f)
 r←1

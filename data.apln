:Namespace data
    ⍝ data science for Dyalog APL
    ⍝ PROOF-OF-CONCEPT jgl@dyalog.com 2024

    debug←1

    MAXLINES←25
    SHADE←3

    :Class Series ⍝ labelled list

        :Field Public label←''
        :Field Public values←⍬

        ∇ Make0
          :Access Public
          :Implements Constructor
        ∇

        ∇ Make2(l v)
          :Access Public
          :Implements Constructor
          label values←l v
        ∇

        ⍝ format in a column with its label as header
        ⍝ also check values rank and update frames
        ∇ setseries;f
          :Implements Trigger label,values
          ⎕SIGNAL(1<≢⍴values)/4 ⍝ rank
          ⎕DF ¯1↓[⎕IO+1]⍕1(↑⍪'─'⍪↓)⍕(⊂,label)⍪⍪,values
          ⍝ update frames referencing this series
          :For f :In ⎕INSTANCES Frame
              ⎕THIS{⍺∊⍵.series:⍵.series←⍺@(⍺∘≡¨)⊢⍵.series}f
          :EndFor
        ∇

        ⍝ bracket indexing return values
        :Property Default default
        :Access Private
            ∇ r←get
              r←values
            ∇
            ∇ set arg
              values←arg.NewValue
            ∇
        :EndProperty

      ⍝ return selection w with label l (default label)
        ∇ s←{l}Sel w
          :Access Public
          l←{⍵:label ⋄ l}0=⎕NC'l'
          s←⎕NEW ##.Series(l(values[w]))
        ∇

    :EndClass ⍝ Series

    :Class Frame ⍝ list of series of the same length

        :Field Public index←0⍴⎕NEW Series
        :Field Public columns←0⍴⎕NEW Series
        :Field Public MAXLINES←##.MAXLINES
        :Field Public SHADE←##.SHADE
        IDX←⊢

        ∇ Make0
          :Access Public
          :Implements Constructor
          MAXLINES SHADE←##.(MAXLINES SHADE)
        ∇

        ∇ Make1 a
          :Access Public
          :Implements Constructor
          ⎕SIGNAL(1<≢⍴a)/4 ⍝ rank
          columns←,a
          MAXLINES SHADE←##.(MAXLINES SHADE)
        ∇

        ⍝ set index function I and frame of each series
        ∇ setframe arg;f;⎕TRAP
          :Implements Trigger index,columns,SHADE,MAXLINES
          :Access Private
          ⎕TRAP←(~##.debug)/⊂0 'C' '⎕SIGNAL⎕EN'
          ⎕SIGNAL(~∧/series∊⎕INSTANCES ##.Series)/11 ⍝ domain
          ⎕SIGNAL(1<≢∪⍴¨series.values)/6             ⍝ value
          :Select arg.Name
          :Case 'index'
              I←series.label∘⍳
              IDX←({↓⍉↑⍵}⍣(1<≢index)⊢index.values)∘⍳⍣(~0∊⍴index)
          :Case 'columns'
              I←series.label∘⍳
          :EndSelect
          f←index(FMT⍤⊣,'│',⊢)⍣(~0∊⍴index)⊢FMT columns
          f←SHADE{0=⍺:⍵ ⋄ ↑'░'@(=∘' ')¨@((0=⍺|2-⍨⍳≢⍵)⍨)↓⍵}f
          ⎕DF MAXLINES{⍺≤0:⍵ ⋄ ↑(⊂'…',⍕n-2),⍨⍣(n>2+⍺)↓(⍺⌊n←≢⍵)↑⍵}f
        ∇
        NIL←'⍬'@(≡∘⍬¨) ⋄ DRY←{⍉' '@(0,2≡/⊢)⍤1⍉⍵}
        FMT←{1(↑⍪'─'⍪↓)⍕⍵.label⍪DRY NIL⍉⍪⍉↑[⎕IO]⍵.values}∘,

        ⍝ bracket indexing rank-1 [] to return series
        ⍝ bracket indexing rank-2 [;] to return values
        :Property Keyed iloc
        :Access Public
            ∇ r←get arg;⎕TRAP
              ⎕TRAP←(~##.debug)/⊂0 'C' '⎕SIGNAL⎕EN'
              :Select ≢arg.Indexers
              :Case 1
                  r←⊢gets arg
              :Case 2
                  r←(⊢gets arg)⊢getv arg
              :Else
                  ⎕SIGNAL 4
              :EndSelect
            ∇
            ∇ set arg;⎕TRAP
              ⎕TRAP←(~##.debug)/⊂0 'C' '⎕SIGNAL⎕EN'
              :Select ≢arg.Indexers
              :Case 1
                  ⊢sets arg
              :Case 2
                  (⊢gets arg)⊢setv arg
              :Else
                  ⎕SIGNAL 4
              :EndSelect
            ∇
        :EndProperty

        ⍝ bracket indexing rank-1 [] to return series
        ⍝ bracket indexing rank-2 [;] to return values
        :Property Keyed Default loc
        :Access Public
            ∇ r←get arg;⎕TRAP
              ⎕TRAP←(~##.debug)/⊂0 'C' '⎕SIGNAL⎕EN'
              :Select ≢arg.Indexers
              :Case 1
                  r←I gets arg
              :Case 2
                  r←(I gets arg)IDX getv arg
              :Else
                  ⎕SIGNAL 4
              :EndSelect
            ∇
            ∇ set arg;⎕TRAP
              ⎕TRAP←(~##.debug)/⊂0 'C' '⎕SIGNAL⎕EN'
              :Select ≢arg.Indexers
              :Case 1
                  I sets arg
              :Case 2
                  (I gets arg)IDX setv arg
              :Else
                  ⎕SIGNAL 4
              :EndSelect
            ∇
        :EndProperty

        ⍝ helper fns and ops to get/set series and values
        ais←{⍵.IndexersSpecified} ⋄ ai←{⊃⌽⍵.Indexers}
        gets←{~⊃⌽ais⍵:columns ⋄ series[⍺⍺ai⍵]}
        sets←{~⊃⌽ais⍵:columns⊢←⍵.NewValue ⋄ series[⍺⍺ai⍵]←⍵.NewValue}
        av←{↑[⎕IO]⍣(0<≢⍴⍺)⊢⍵} ⋄ va←{↓[⎕IO]⍣(1<≢⍴⍵)⊢⍵}
          getv←{
              ~⊃ais ⍵:⍺ av ⍺.values ⋄ aa←⍺⍺
              ⍺{0<≢⍴⍺:↑[⎕IO]⍵ ⋄ ⊃⍵}⍺{⍺.values[aa ⍵]}¨1↑⍵.Indexers
          }
          setv←{
              ~⊃ais ⍵:⍺.values←{↓[⎕IO]⍣(0<≢⍴⍵)⊢⍵}⍵.NewValue
              ⍺((⍺⍺⊃⍵.Indexers){⍺.values[⍺⍺]←⍵})¨va ⍵.NewValue
          }

      ⍝ return columns w with index a (default none)
        ∇ r←{a}Col w;⎕TRAP
          :Access Public
          ⎕TRAP←(~##.debug)/⊂0 'C' '⎕SIGNAL⎕EN'
          r←{0=⎕NC'a':I col ⍵ ⋄ a I col ⍵}w
        ∇

      ⍝ return columns w with index a (default none)
        ∇ r←{a}iCol w;⎕TRAP
          :Access Public
          ⎕TRAP←(~##.debug)/⊂0 'C' '⎕SIGNAL⎕EN'
          r←{0=⎕NC'a':⊢col ⍵ ⋄ a⊢col ⍵}w
        ∇

        ⍝ helper op to get frame of columns with given index
          col←{
              ⍺←⍬ ⋄ r←series[,⍺⍺ ⍺]##.frame series[,⍺⍺ ⍵]
              r.(MAXLINES SHADE)←MAXLINES SHADE ⋄ r
          }

      ⍝ return selection w with index a (default index)
        ∇ r←{a}Sel w;⎕TRAP
          :Access Public
          ⎕TRAP←(~##.debug)/⊂0 'C' '⎕SIGNAL⎕EN'
          :If 0=⎕NC'a'
              a←,IDX w
              r←index ##.frame⍥(a∘sel)columns
          :Else
              r←(loc[a]##.frame series).Sel w
              r←r[⊂⍣(⍬≡⍴index)⊢index.label]##.frame r[columns.label]
          :EndIf
          r.(MAXLINES SHADE)←MAXLINES SHADE
        ∇
        sel←{⍺∘{⍵.label ##.series ⍵[⍺]}¨⍣(0<≢⍵)⊢⍵}

      ⍝ return selection w with index a (default index)
        ∇ r←{a}iSel w;⎕TRAP
          :Access Public
          ⎕TRAP←(~##.debug)/⊂0 'C' '⎕SIGNAL⎕EN'
          :If 0=⎕NC'a'
              a w←{0::⍵ ⋄ ⍵.label ##.series ⍵[,w]}¨¨index columns
              r←a ##.frame w
          :Else
              r←Sel{0::⍵[w] ⋄ 0::⍵.values[w] ⋄ ⍵.iloc[w;]}a
          :EndIf
          r.(MAXLINES SHADE)←MAXLINES SHADE
        ∇

      ⍝ return selection a (default all) of columns w
        ∇ r←{a}Loc w;⎕TRAP
          :Access Public
          ⎕TRAP←(~##.debug)/⊂0 'C' '⎕SIGNAL⎕EN'
          r←{0=⎕NC'a':⍵ ⋄ ⍵.Sel a}index(~##.frame⊢)series[,I w]
          r.(MAXLINES SHADE)←MAXLINES SHADE
        ∇

      ⍝ return selection a (default all) of columns w
        ∇ r←{a}iLoc w;⎕TRAP
          :Access Public
          ⎕TRAP←(~##.debug)/⊂0 'C' '⎕SIGNAL⎕EN'
          r←{0=⎕NC'a':⍵ ⋄ ⍵.iSel a}index(~##.frame⊢)series[,w]
          r.(MAXLINES SHADE)←MAXLINES SHADE
        ∇

        :Property series ⍝ ←→ df.(index,columns)
        :Access Public
            ∇ r←get
              r←index,columns
            ∇
            ∇ set arg
              index columns←(≢index)(↑,⍥⊂↓)arg.NewValue
            ∇
        :EndProperty

        :Property indices ⍝ ←→ ↓⍉↑df.index.values
        :Access Public
            ∇ r←get
              r←{0∊⍴⍵:0⍴⊂⍬ ⋄ 1<≢⍵:↓⍉↑⍵.values ⋄ (⊃⍵).values}index
            ∇
            ∇ set arg
              index.values←index{1<≢⍺:↓⍉↑⍵ ⋄ ⍬≢⍴⍺:⊂⍵ ⋄ ⍵}arg.NewValue
            ∇
        :EndProperty

        :Property labels ⍝ ←→ df[].label
        :Access Public
            ∇ r←get
              r←columns.label
            ∇
            ∇ set arg
              columns.label←arg.NewValue
            ∇
        :EndProperty

        :Property values ⍝ ←→ df[;]
        :Access Public
            ∇ r←get
              r←↑[⎕IO]columns.values
            ∇
            ∇ set arg
              columns.values←↓[⎕IO]arg.NewValue
            ∇
        :EndProperty

        :Property table ⍝ ←→ df.(indices,values)
        :Access Public
            ∇ r←get
              r←↑[⎕IO]series.values
            ∇
            ∇ set arg
              series.values←↓[⎕IO]arg.NewValue
            ∇
        :EndProperty

    :EndClass ⍝ Frame

    ⍝ return series or list of series
    ⍝ horizontal: concatenate series with ,
    ⍝ vertical: concatenate values with ⍪
    ∇ s←{l}series v;⎕TRAP
      ⎕TRAP←(~⎕THIS.debug)/⊂0 'C' '⎕SIGNAL⎕EN'
      ⎕SIGNAL(2<≢⍴v)/4 ⍝ rank
      :If 0≠⎕NC'l'
          ⎕SIGNAL(1<≢⍴v)/4 ⍝ rank
          l←{0::⍵ ⋄ ⍵.label}l
          s←⎕NEW Series(l v)
      :ElseIf 2=≢⍴v
          s←{
              2::⎕NEW Series(''(⍺,⍵))
              2::⎕NEW Series(⍺.label(⍺.values,⍵))
              2::⎕NEW Series(⍵.label(⍺,⍵.values))
              ⍺.label≢⍵.label:⎕SIGNAL 6
              ⎕NEW Series(⍺.label(⍺.values,⍵.values))
          }⌿v
      :Else
          v←⊃,/{2 6::⍵ ⋄ ⍵.series[]}¨v
          s←{
            0∊⍴⍵:0⍴⎕NEW Series
            ~∧/⍵∊⎕INSTANCES Series:⎕NEW Series(''⍵)
            {⎕NEW Series ⍵.(label values)}¨⍵
          }v
      :EndIf
    ∇

    ⍝ return frame from input to series or csv filename
    ∇ f←{l}frame v;⎕TRAP
      ⎕TRAP←(~⎕THIS.debug)/⊂0 'C' '⎕SIGNAL⎕EN'
      :If 0≠⎕NC'l'
          f←⍬
          v←l{
              80≠⎕DR ⍵:↓[⎕IO]⍣(2=≢⍴⍵)⊢⍵
              b←⍺{∧/(⊃∘⊃∘⎕CLASS¨⍺)∊Series Frame}⍣(⊃9=⎕NC'⍺')⊢0
              ~b:⎕CSV⍠2⊢v'' 4 0
              _←⍺[].values(⍺[].label)⎕CSV⍠2⍠'IfExists' 'Replace'⊢⍵
              ⊢f⊢←⍺
          }v
          f←{
              0::⍵ ⋄ s←series v ⋄ ~∧/l∊s.label:⍵
              f←⎕NEW Frame(s~i←s[s.label⍳l]) ⋄ f.index←i
              {0::⍵ ⋄ ⍵.(SHADE MAXLINES)←v.(SHADE MAXLINES) ⋄ ⍵}f
          }f
          :If 0∊⍴f
              f←⊃,/{0::⊂⍵ ⋄ ⍵.columns}¨v
              :If ∧/l∊⊃,/⎕INSTANCES¨Series Frame
                  l←series l
                  :If ∧/f∊⎕INSTANCES Series
                      f←⎕NEW Frame(series f~l) ⋄ f.index←l
                  :Else
                      f←⎕NEW Frame(l.label series f)
                  :EndIf
              :Else
                  f←⎕NEW Frame(l{⎕NEW Series(⍺ ⍵)}¨f)
                  v←{0::⍬ ⋄ ⍵.index←v.index}f
              :EndIf
              v←{0::⍬ ⋄ ⍵.(SHADE MAXLINES)←l.(SHADE MAXLINES)}f
          :EndIf
      :Else
          l←{0::0⍴⎕NEW Series ⋄ ⍵.index}v
          f←{
              80≠⎕DR ⍵:series ⍵
              {(v l)←⍵ ⋄ l{⎕NEW Series(⍺ ⍵)}¨v}⎕CSV⍠2⊢⍵'' 4 1
          }{0::⍵ ⋄ ⍵.columns}v
          f←⎕NEW Frame f ⋄ f.index←l
          v←{0::⍬ ⋄ ⍵.(SHADE MAXLINES)←v.(SHADE MAXLINES)}f
      :EndIf
    ∇

    ⍝ find or replace nan values
      nan←{
          ⎕TRAP←(~debug)/⊂0 'C' '⎕SIGNAL⎕EN'
          n←(0=2|⎕DR¨){0::⍵ ⋄ ⍵.values}⍵
          0=⎕NC'⍺':n ⋄ 0::(⍴⍵)⍴⍺@(,n⍨)⊢,⍵ ⋄ v←⍺@(,n⍨)⊢,⍵.values
          ⍵∊⎕INSTANCES Series:⍵.label series v
          f←⍵.index frame⍥series ⍵.columns ⋄ (,f.values)←v ⋄ f
      }

    ⍝ sort right argument by left argument
      sort←{
          ⎕TRAP←(~debug)/⊂0 'C' '⎕SIGNAL⎕EN'
          s←series ⍵ ⋄ ⍺←{0::s ⋄ 0<≢⍵.index:⍵.index ⋄ s}⍵
          g←⊃⍺⍺{⍵[⍺⍺(⊂⍵)⌷⍺]}/{⍵,⊂⍳≢⊃⍵}(⍺{0::,⍺ ⋄ ⍵[,⍺]}⍵).values
          f←{⍵.label series ⍵[g]}¨s
          f←⍵ frame{0::⍺⍺ ⍵ ⋄ 0<n←≢⍺.index:n(↑⍺⍺↓)⍵ ⋄ ⍺⍺ ⍵}f
          ⍵{0::⍵ ⋄ ⍵.(SHADE MAXLINES)←⍺.(SHADE MAXLINES) ⋄ ⍵}f
      }

    ⍝ apply left operand to values at right operand
      at←{
          ⎕TRAP←(~debug)/⊂0 'C' '⎕SIGNAL⎕EN' ⋄ ⍺←⊢
          (⊂⍵)∊⎕INSTANCES Series:⍵.label series ⍺(⍺⍺@⍵⍵)⍵.values
          (i s)←{0::(0⍴⎕NEW Series)(⍵[]) ⋄ ⍵.(index.label series)}⍵
          l←⍵⍵{3≠⎕NC'⍺⍺':⍺⍺ ⋄ ⍵⍳⍺⍺ ⍵}s.label
          s←⍺∘⍺⍺{⍵.label series ⍺⍺⊣⍵[]}¨@l⊢s
          ⍵{(≢⍺.index)(↑frame↓)⍵}⍣((⊂⍵)∊⎕INSTANCES Frame)⊢s
      }

    ⍝ group by right operand and apply left operand
      by←{
          ⎕TRAP←(~debug)/⊂0 'C' '⎕SIGNAL⎕EN'
          unstack←{
              f←frame b a,⍨s←⍵.series~a b←⍺⍺ ⍵⍵{0::⍺ ⋄ ⍵[⊂⍺]}¨⊂⍵
              c←≢x←{⍵[⍋⍵]}∪b.values
              r←≢y←{⍵[⍋⍵;]}∪↑[⎕IO]s.values
              _←{1<≢⍵:⎕SIGNAL 5 ⋄ ⍵}by(b,s)⊢a
              f←f.labels frame((↑,y∘.,⍥(⊂¨)x),⍤1⊢⍬⍨¨a)⍪f.values
              f←{⊃⍣(1<≢⍵)⊢,⌿⍵}by(f[(b,s).label])⊢f[⊂a.label]
              ⍺←⊢ ⋄ l←{0::⍵ ⋄ ⍵[].label}⍺⊣s.label,x
              f←(≢s)(↑frame↓)(l frame y,⍉c r⍴f[;⊂a.label])[]
              ⍵{0::⍵ ⋄ ⍵.(SHADE MAXLINES)←⍺.(SHADE MAXLINES) ⋄ ⍵}f
          }
          stack←{
              0=⎕NC'⍺':⍺⍺ unstack ⍵⍵⊢⍵
              s←⍵.series~a←⍺{0::⍺ ⋄ ⍵[⍺]}⍵
              v←⊃(⊂¨a.label)⍪.,(⊂↑[⎕IO]s.values),¨a.values
              f←1(↑frame↓)((⊂⍵⍵),s.label,⊂⍺⍺)series¨↓[⎕IO]v
              ⍵{0::⍵ ⋄ ⍵.(SHADE MAXLINES)←⍺.(SHADE MAXLINES) ⋄ ⍵}f
          }
          ⍺←⊢ ⋄ v←frame⍣(~(⊂⍵)∊⎕INSTANCES Frame)⊢⍵
          3≠⎕NC'⍺⍺':⍺(⍺⍺ stack ⍵⍵)v
          (k v)←{3 11::⍵ v ⋄ (,v[⍵])(v[]~⊢v[⍵])}⍵⍵
          l←{2::⍬ ⋄ (,⍵).label}k
          (kv vv)←{0::{0::⍵ ⋄ (,⍵).values}⍵ ⋄ ⍵[].values}¨k v
          vv←⊃⍪/⊂⍤2⊢kv,⍤1∘⍺⍺⌸⍥(↑[⎕IO])vv
          l←⍺{
              0::⎕SIGNAL 6 ⋄ 0=⎕NC'⍺':l,⍵[].label
              (vl←⊃⌽⍴vv)=≢⍺:⍺ ⋄ vl=≢l,⍺:l,⍺ ⋄ l,⍵.label,⍺
          }v
          f←l frame vv ⋄ i←f[(⊃⌽⍴kv)↑l] ⋄ f←⍋sort i frame f[]~i
          ⍵{0::⍵ ⋄ ⍵.(SHADE MAXLINES)←⍺.(SHADE MAXLINES) ⋄ ⍵}f
      }

    ⍝ join frames or data arrays in a frame
      join←{
          ⎕TRAP←(~debug)/⊂0 'C' '⎕SIGNAL⎕EN'
          ww←⍵⍵{⍺←⊢ ⋄ 3≠⎕NC'⍺⍺':⍺⍺ ⋄ ⍺ ⍺⍺ ⍵}⍥{⍵.series.label}
          0=⎕NC'⍺':(ww f)series ⍺⍺(f←frame ⍵).values
          wl←{0::⍵.label ⋄ ⍵.series.label}⍵
          (a w)←frame∘series¨⍺ ⍵ ⋄ l←a ww w ⋄ al←l~wl
          3≠⎕NC'⍺⍺':⍵⍵{
              kl←l∩a∩⍥{⍵.labels}w ⋄ k←a ⍺⍺¨⍥{⍵[kl].values}w
              (ia iw)←{⍵[kl].values⍳⍥(↑[⎕IO])k}¨a w
              (la lw)←al wl~¨⊂kl ⋄ i←l∩a,⍥{0::⍬ ⋄ ⍵.index}w
              a←((↑[⎕IO]a[la].values)⍪(≢la)↑⍵)[ia;]
              w←((↑[⎕IO]w[lw].values)⍪(-≢lw)↑⍵)[iw;]
              f←(kl,la,lw)frame(⊃,/⍪¨k),a,w ⋄ i frame f
          }⍺⍺
          f←frame a[al],⍣(0<≢al)⊢w[l∩wl]
          i←⍺∪⍥{0::0⍴⎕NEW Series ⋄ (,⍵.index).label}⍵
          i frame frame ⍺⍺{
              ~(⊂l←⊂⍵.label)∧.∊(f a w).labels:⍵
              ⍵.label series a[;l]⍺⍺ ⍵[]
          }¨f[]
      }

:EndNamespace
